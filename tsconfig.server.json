{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true
  },
  "include": [
    "server/**/*.ts",
    "api/**/*.ts",
    "scripts/**/*.ts",
    "shared/**/*.ts",
    "prisma.config.ts"
  ]
}
