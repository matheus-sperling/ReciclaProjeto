{
  "name": "recicla-mais",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx server/local.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "prisma generate && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:recover": "tsx scripts/recover-admin.ts",
    "db:provision": "tsx scripts/provision-roles.ts",
    "test:setup": "tsx tests/setup-db.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "chart.js": "4.5.1",
    "html5-qrcode": "2.3.8",
    "leaflet": "1.9.4",
    "lucide-vue-next": "1.0.0",
    "pg": "8.23.1",
    "qrious": "4.0.2",
    "reka-ui": "2.10.5",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.10.13",
    "@types/pg": "8.16.0",
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11",
    "workbox-precaching": "7.4.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
