# Runtime: configure privately in Vercel, never use the database owner here.
APP_ORIGIN=https://seu-projeto.vercel.app
# Use the NOBYPASSRLS login roles created by the protected provision step.
DATABASE_URL=postgresql://recicla_app_login:SENHA@HOST/neondb?sslmode=require
AUTH_DATABASE_URL=postgresql://recicla_auth_login:SENHA@HOST/neondb?sslmode=require
BETTER_AUTH_SECRET=GERAR_32_BYTES_ALEATORIOS_OU_MAIS
# Only the protected migration/bootstrap environment receives DIRECT_URL.
DIRECT_URL=postgresql://PROPRIETARIO:SENHA@HOST_DIRETO/neondb?sslmode=require
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
